<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top 1dp frosted glass highlight rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
        </shape>
    </item>
    <!-- Translucent Frosted Glass Background (Glassmorphism) -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#9914141C"
                android:centerColor="#CC101016"
                android:endColor="#E60D0D12" />
        </shape>
    </item>
</layer-list>