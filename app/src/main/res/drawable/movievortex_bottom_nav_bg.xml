<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top 1dp crisp border line -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#282830" />
        </shape>
    </item>
    <!-- Dark Obsidian Gradient Navigation Dock Background -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F0121216"
                android:endColor="#FA0A0A0E" />
        </shape>
    </item>
</layer-list>